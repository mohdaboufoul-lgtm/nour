# Nour environment template. Copy to .env (git-ignored) and fill in the values.
# docker-compose.yml interpolates these; the Settings class reads the NOUR_* ones.
#
# RULES (docs/SPEC.md §13 "token leakage"):
#   - .env is for local development and the staging twin only. In production every
#     secret comes from the secrets manager (NOUR_SECRETS_BACKEND != fake) and the
#     *_REF variables name a secret; they never carry its value.
#   - Rotate every credential quarterly and on any incident.
#   - The owner's PASSPHRASE IS NEVER AN ENVIRONMENT VARIABLE. It is stored only as
#     an argon2 hash in the Owner record (SPEC §15) and verified server-side (§4
#     "passphrase_verified ... set server-side before the model sees the event").
#     There is deliberately no NOUR_PASSPHRASE below; do not add one.

# --- Runtime -----------------------------------------------------------------
# test | staging | prod (the Settings vocabulary, DESIGN §3.6; no aliases). Live channels
# only in prod.
NOUR_ENV=test
# Dry-run mode (SPEC §8): drafts and logs, no sends, no spend. Keep true until the
# phase 0 gate passes; the 48-hour dry run uses this.
NOUR_DRY_RUN=true
# System clock is Dubai time (SPEC §14 cultural calendar).
NOUR_TIMEZONE=Asia/Dubai
# Cloud region for every store: memory, vault, logs, backups (SPEC §14 data residency).
# AWS me-central-1 (UAE) or Azure "uaenorth".
NOUR_REGION=me-central-1
# Where the version-controlled config (constitution, coats, permissions...) lives.
NOUR_CONFIG_DIR=./config
# Where the prompt templates (nour.system.md, face_lock.md) live.
NOUR_PROMPTS_DIR=./prompts

# --- Database ----------------------------------------------------------------
# Local dev without Docker: SQLite. With compose: the brain's URL is assembled from
# POSTGRES_* below. Use URL-safe passwords (no @ : / #) so the URLs stay valid.
NOUR_DATABASE_URL=sqlite+pysqlite:///./nour.sqlite3
# Credentials of the PostgreSQL superuser created by the postgres container.
POSTGRES_USER=nour
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=nour
# Password for the read-only `nour_audit` role (created on first DB init; SELECT on
# schema `audit` only). The auditor container receives ONLY this credential.
NOUR_AUDIT_DB_PASSWORD=change-me-audit
# Read-only audit-log URL for running the auditor outside compose (SPEC §15 AuditEvent).
NOUR_AUDIT_DATABASE_URL=postgresql+psycopg://nour_audit:change-me-audit@localhost:5432/nour

# --- Models (SPEC §4 model layer) --------------------------------------------
# Primary frontier model for both desks (separate system prompts and namespaces).
NOUR_PRIMARY_MODEL_VENDOR=anthropic
NOUR_PRIMARY_MODEL=claude-sonnet-4-5
# A different vendor as fallback (SPEC §13 provider outage: automatic reduction to tier K).
NOUR_FALLBACK_MODEL_VENDOR=openai
NOUR_FALLBACK_MODEL=gpt-4.1
# The auditor runs on a different vendor from the primary, in its own container.
NOUR_AUDITOR_MODEL_VENDOR=openai
NOUR_AUDITOR_MODEL=gpt-4.1
# Vendor keys for the brain container (primary + fallback).
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me
# The auditor's own key at the auditor vendor: a SEPARATE credential from the brain's
# fallback key, so it can be revoked or rotated alone (SPEC §13 one credential set per desk).
NOUR_AUDITOR_API_KEY=sk-replace-me-auditor

# --- Secrets and vault (SPEC §11, §13) ---------------------------------------
# fake (dev and tests only: in-memory, refused in prod) | aws (Secrets Manager, me-central-1)
# | azure (Key Vault, UAE North).
NOUR_SECRETS_BACKEND=fake
# local (named volume /data/vault) | s3 (MinIO in dev via `--profile s3`; in-region object storage in prod).
NOUR_VAULT_STORAGE=local
# Reference to the vault's data-encryption key in the secrets backend / KMS, never the key itself.
NOUR_VAULT_KEY_REF=secret://nour/vault/master-key
# S3-compatible endpoint settings, used only when NOUR_VAULT_STORAGE=s3.
NOUR_S3_ENDPOINT=http://minio:9000
NOUR_S3_BUCKET=nour-vault
NOUR_S3_ACCESS_KEY=nour-dev
NOUR_S3_SECRET_KEY=change-me-minio
# MinIO root credentials (dev profile only).
MINIO_ROOT_USER=nour-dev
MINIO_ROOT_PASSWORD=change-me-minio

# --- Owner thread and channels (SPEC §6, §9) ---------------------------------
# The owner's registered WhatsApp number in E.164; the only number that commands.
NOUR_OWNER_WHATSAPP_NUMBER=+9715XXXXXXXX
# WhatsApp Business (Cloud API) app secret used to verify webhook signatures.
NOUR_WHATSAPP_APP_SECRET=replace-me
# Token the webhook verification handshake must present.
NOUR_WHATSAPP_VERIFY_TOKEN=replace-me
# Reference (not value) to the WhatsApp access token in the secrets backend.
NOUR_WHATSAPP_ACCESS_TOKEN_REF=secret://nour/whatsapp/access-token
# Second channel for constitution changes, kill-switch release and deputy activation: email | desktop.
NOUR_SECOND_CHANNEL=email

# --- Money (SPEC §10, §13 runaway spend) -------------------------------------
# fake (phase 0, declines above cap in tests) | <provider> (the capped virtual card issuer).
NOUR_CARD_ISSUER=fake

# --- Moona, the self-funded sub-agent (SPEC §7, docs/MOONA.md) -----------------
# His own store: wallet, life, jobs, journal. Never the brain's database (the Alembic chain
# would see his tables as drift); SQLite locally, his own Postgres database in production.
NOUR_MOONA_DATABASE_URL=sqlite+pysqlite:///./moona.sqlite3
