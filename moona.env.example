# Moona on Android (docs/MOONA_ANDROID.md). Copy to moona.env, which is
# git-ignored, and fill in. moona-android.sh reads this file.
#
# Her thinking is paid from this key. Funding it with the $50 prepaid card is
# the most literal way to make the balance truly hers: when its credit runs
# out, she stops.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional; moona.py's docstring documents every MOONA_* setting.
MOONA_HOME=./moona_home
# claude-fable-5-1 is the smartest model; claude-opus-5-5 is cheaper and still strong.
# claude-haiku-5-5 is cheapest, for the longest life on $50.
MOONA_MODEL=claude-fable-5-1
# low | medium | high | xhigh | max. max is the sharpest and the fastest to spend.
MOONA_EFFORT=max
MOONA_START_BALANCE=50.00

# Her own channels, each off until set. The mailbox must be hers, not yours.
#MOONA_EMAIL=moona@example.com
#MOONA_EMAIL_PASSWORD=app-password
#MOONA_SMTP_HOST=smtp.example.com
#MOONA_IMAP_HOST=imap.example.com
# A Stripe RESTRICTED key (rk_...) that can take money in but never pay out.
#MOONA_STRIPE_KEY=rk_live_replace-me
# Where clients pay by transfer; she puts it on invoices, never posts it.
#MOONA_BANK_DETAILS=Bank X, IBAN AE00 0000 0000 0000 0000 000, account name Moona
# Your address, so her daily report and messages reach you by email (needs her mailbox).
#MOONA_OWNER_EMAIL=you@example.com
